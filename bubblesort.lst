                   ; ==============================================================================
                   ; Bubble Sort Implementation in IITPSx Assembly
                   ; Name: Aahan Nayak
                   ; Roll No: 2501AI21
                   ;
                   ; Description:
                   ;   Sorts an array of 32-bit signed integers in ascending order in-place
                   ;   using the Bubble Sort algorithm.
                   ;
                   ; Memory Layout:
                   ;   count: size of array (N)
                   ;   array: start of N 32-bit integers
                   ; ==============================================================================
                   
00000000 00100000          ldc 0x1000
00000001 0000000B          a2sp
00000002 0000010D          call sort
00000003 00000012          HALT
                   
                   ; ==============================================================================
                   ; sort subroutine
                   ; Stack Frame (SP):
                   ;   SP + 0: i (outer loop index)
                   ;   SP + 1: j (inner loop index)
                   ;   SP + 2: return address
                   ;   SP + 3: ptr = &array[j]
                   ;   SP + 4: val_j
                   ;   SP + 5: val_j_plus_1
                   ; ==============================================================================
00000004 FFFFFA0A  sort:   adj -6
00000005 00000203          stl 2               ; Save return address
                   
00000006 00000000          ldc 0
00000007 00000003          stl 0               ; i = 0
                   
00000008 00003A00  outer:  ldc count
00000009 00000004          ldnl 0
0000000A FFFFFF01          adc -1              ; count - 1
0000000B 00000002          ldl 0
0000000C 00000007          sub                 ; (count - 1) - i
0000000D 00002910          brlz done
0000000E 0000280F          brz done
                   
0000000F 00000000          ldc 0
00000010 00000103          stl 1               ; j = 0
                   
00000011 00003A00  inner:  ldc count
00000012 00000004          ldnl 0
00000013 FFFFFF01          adc -1
00000014 00000002          ldl 0
00000015 00000007          sub                 ; limit = count - 1 - i
00000016 00000102          ldl 1
00000017 00000007          sub                 ; limit - j
00000018 00001A10          brlz next_i
00000019 0000190F          brz next_i
                   
                           ; Compute ptr = &array[j] and store in SP[3]
0000001A 00003B00          ldc array
0000001B 00000102          ldl 1
0000001C 00000006          add
0000001D 00000303          stl 3               ; SP[3] = ptr
                   
                           ; Load val_j = memory[ptr + 0] into SP[4]
0000001E 00000302          ldl 3
0000001F 00000004          ldnl 0
00000020 00000403          stl 4               ; SP[4] = val_j
                   
                           ; Load val_j_plus_1 = memory[ptr + 1] into SP[5]
00000021 00000302          ldl 3
00000022 00000104          ldnl 1
00000023 00000503          stl 5               ; SP[5] = val_j_plus_1
                   
                           ; Compare: we want val_j <= val_j_plus_1
                           ; Compute val_j - val_j_plus_1:
                           ; If val_j > val_j_plus_1, we must swap.
                           ; To compute val_j - val_j_plus_1:
                           ; Put val_j into B, and val_j_plus_1 into A, then sub.
00000024 00000402          ldl 4               ; A = val_j
00000025 00000502          ldl 5               ; B = val_j, A = val_j_plus_1
00000026 00000007          sub                 ; A = B - A = val_j - val_j_plus_1
                           ; If val_j - val_j_plus_1 > 0, swap!
                           ; Notice that if A > 0, then:
                           ; A is NOT zero, and A is NOT less than zero.
00000027 0000070F          brz no_swap         ; If equal, don't swap
00000028 00000610          brlz no_swap        ; If val_j < val_j_plus_1, don't swap
                   
                           ; SWAP elements in memory:
                           ; memory[ptr + 1] := val_j
00000029 00000402          ldl 4               ; A = val_j
0000002A 00000302          ldl 3               ; B = val_j, A = ptr
0000002B 00000105          stnl 1              ; memory[ptr + 1] := val_j
                   
                           ; memory[ptr + 0] := val_j_plus_1
0000002C 00000502          ldl 5               ; A = val_j_plus_1
0000002D 00000302          ldl 3               ; B = val_j_plus_1, A = ptr
0000002E 00000005          stnl 0              ; memory[ptr + 0] := val_j_plus_1
                   
                   no_swap:
0000002F 00000102          ldl 1
00000030 00000101          adc 1
00000031 00000103          stl 1               ; j = j + 1
00000032 FFFFDE11          br inner
                   
00000033 00000002  next_i: ldl 0
00000034 00000101          adc 1
00000035 00000003          stl 0               ; i = i + 1
00000036 FFFFD111          br outer
                   
00000037 00000202  done:   ldl 2
00000038 0000060A          adj 6
00000039 0000000E          return
                   
                   ; ==============================================================================
                   ; Data Section
                   ; ==============================================================================
0000003A 00000006  count:  data 6
0000003B 00000019  array:  data 25
0000003C FFFFFFFC          data -4
0000003D 0000000A          data 10
0000003E 00000000          data 0
0000003F FFFFFFF1          data -15
00000040 00000008          data 8
