                   ; ==============================================================================
                   ; Test Case: Fibonacci Sequence Generator (Iterative)
                   ; Author: Aahan Nayak
                   ; Roll No: 2501AI21
                   ;
                   ; Description:
                   ;   Generates the first 8 Fibonacci numbers: 0, 1, 1, 2, 3, 5, 8, 13
                   ;   Stores them into the 'fib' array in memory.
                   ; ==============================================================================
                   
00000000 00100000          ldc 0x1000
00000001 0000000B          a2sp
00000002 FFFFFC0A          adj -4
                   
                           ; Initialize first two terms: fib[0] = 0, fib[1] = 1
00000003 00002500          ldc fib
00000004 00000000          ldc 0
00000005 00000005          stnl 0
                   
00000006 00002500          ldc fib
00000007 00000100          ldc 1
00000008 00000105          stnl 1
                   
                           ; Loop index i = 2
00000009 00000200          ldc 2
0000000A 00000003          stl 0           ; stack[0] = i = 2
                   
                   fib_loop:
                           ; Check if i == count (8)
0000000B 00000002          ldl 0
0000000C 00002400          ldc count
0000000D 00000004          ldnl 0
0000000E 00000007          sub             ; i - count
0000000F 0000130F          brz fib_done    ; if i == count, exit loop
                   
                           ; Compute fib[i-1] + fib[i-2]
                           ; Load fib[i-1]
00000010 00002500          ldc fib
00000011 00000002          ldl 0
00000012 00000006          add
00000013 FFFFFF01          adc -1
00000014 00000004          ldnl 0          ; A = fib[i-1]
                   
                           ; Load fib[i-2]
00000015 00002500          ldc fib
00000016 00000002          ldl 0
00000017 00000006          add
00000018 FFFFFE01          adc -2
00000019 00000004          ldnl 0          ; B = fib[i-1], A = fib[i-2]
                   
0000001A 00000006          add             ; A = fib[i-1] + fib[i-2]
                   
                           ; Store into fib[i]
0000001B 00002500          ldc fib
0000001C 00000002          ldl 0
0000001D 00000006          add
0000001E 00000005          stnl 0          ; fib[i] = A
                   
                           ; i++
0000001F 00000002          ldl 0
00000020 00000101          adc 1
00000021 00000003          stl 0
00000022 FFFFE811          br fib_loop
                   
                   fib_done:
00000023 00000012          HALT
                   
                   ; Data Section
00000024 00000008  count:  data 8
00000025 00000000  fib:    data 0
00000026 00000000          data 0
00000027 00000000          data 0
00000028 00000000          data 0
00000029 00000000          data 0
0000002A 00000000          data 0
0000002B 00000000          data 0
0000002C 00000000          data 0
