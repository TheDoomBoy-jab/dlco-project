                   ; ==============================================================================
                   ; Test Case: Arithmetic Mean & Polynomial using 'mul' and 'div'
                   ; Author: Aahan Nayak
                   ;
                   ; Description:
                   ;   Computes:
                   ;   1. Sum = array[0] + array[1] + array[2] + array[3]
                   ;   2. Mean = Sum / count (using IITPSx 'div')
                   ;   3. Scaled = Mean * Factor (using IITPSx 'mul')
                   ; ==============================================================================
                   
00000000 00100000          ldc 0x1000
00000001 0000000B          a2sp
                   
                           ; Compute sum
00000002 00002000          ldc array
00000003 00000004          ldnl 0          ; A = 10
00000004 00002000          ldc array
00000005 00000104          ldnl 1          ; A = 20, B = 10
00000006 00000006          add             ; A = 30
00000007 00002000          ldc array
00000008 00000204          ldnl 2          ; A = 30, B = 30
00000009 00000006          add             ; A = 60
0000000A 00002000          ldc array
0000000B 00000304          ldnl 3          ; A = 40, B = 60
0000000C 00000006          add             ; A = 100
0000000D 00002400          ldc sum
0000000E 00000005          stnl 0          ; sum = 100
                   
                           ; Mean = Sum / count
0000000F 00002400          ldc sum
00000010 00000004          ldnl 0          ; A = 100
00000011 00001E00          ldc count
00000012 00000004          ldnl 0          ; A = 4, B = 100
00000013 00000014          div             ; A = 100 / 4 = 25
00000014 00002500          ldc mean
00000015 00000005          stnl 0          ; mean = 25
                   
                           ; Scaled = Mean * 3
00000016 00002500          ldc mean
00000017 00000004          ldnl 0          ; A = 25
00000018 00001F00          ldc factor
00000019 00000004          ldnl 0          ; A = 3, B = 25
0000001A 00000013          mul             ; A = 25 * 3 = 75
0000001B 00002600          ldc scaled
0000001C 00000005          stnl 0          ; scaled = 75
                   
0000001D 00000012          HALT
                   
0000001E 00000004  count:  data 4
0000001F 00000003  factor: data 3
00000020 0000000A  array:  data 10
00000021 00000014          data 20
00000022 0000001E          data 30
00000023 00000028          data 40
00000024 00000000  sum:    data 0
00000025 00000000  mean:   data 0
00000026 00000000  scaled: data 0
